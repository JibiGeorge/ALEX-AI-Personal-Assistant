#!/usr/bin/env bash
# Alex Unified CLI Launcher for macOS, Linux, and Windows (Git Bash / MINGW64)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)"

# Discover Python interpreter
if [ -n "${ALEX_PYTHON:-}" ] && [ -x "$ALEX_PYTHON" ]; then
    PYTHON="$ALEX_PYTHON"
elif [ -f "$PROJECT_ROOT/backend/.venv/Scripts/python.exe" ]; then
    PYTHON="$PROJECT_ROOT/backend/.venv/Scripts/python.exe"
elif [ -f "$PROJECT_ROOT/backend/.venv/Scripts/python" ]; then
    PYTHON="$PROJECT_ROOT/backend/.venv/Scripts/python"
elif [ -f "$PROJECT_ROOT/backend/.venv/bin/python" ]; then
    PYTHON="$PROJECT_ROOT/backend/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON="python"
else
    echo "Error: Python 3.11+ is required but not found in PATH or backend/.venv." >&2
    exit 1
fi

if command -v cygpath >/dev/null 2>&1; then
    WIN_ROOT="$(cygpath -w "$PROJECT_ROOT")"
    export PYTHONPATH="$WIN_ROOT${PYTHONPATH:+;$PYTHONPATH}"
else
    export PYTHONPATH="$PROJECT_ROOT:${PYTHONPATH:-}"
fi

exec "$PYTHON" -m launcher.cli "$@"
