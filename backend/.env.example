# ==============================================================================
# Alex Backend — Environment Configuration Template
# Used by Pydantic BaseSettings in backend/app/core/config.py
# ==============================================================================

# API authentication bearer token (leave blank to auto-generate per launch)
# ALEX_API_TOKEN=

# Application data directory (leave blank to use OS default)
# ALEX_DATA_DIR=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
ALEX_LOG_LEVEL=INFO

# Optional Gemini API key fallback (prefer storing in OS Keyring)
GEMINI_API_KEY=

# Local Ollama endpoint
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Local LM Studio endpoint
LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=local-model

# Speech Recognition & Voice
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TTS_ENGINE=piper
WAKE_WORD_ENABLED=false
WAKE_WORD_MODEL=hey_jarvis
