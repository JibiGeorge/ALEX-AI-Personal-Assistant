# ==============================================================================
# Alex Desktop Assistant — Root Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
# Loopback host for the Python FastAPI backend (must remain loopback only)
ALEX_BACKEND_HOST=127.0.0.1

# Default port for the backend API (8765 is default; auto-reassigned if busy)
ALEX_BACKEND_PORT=8765

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
ALEX_LOG_LEVEL=INFO

# Application data directory (leave blank to use OS standard: %APPDATA%/Alex or ~/.alex)
# ALEX_DATA_DIR=

# Python interpreter override (leave blank to auto-discover backend/.venv)
# ALEX_PYTHON=

# API Bearer Token (optional: leave blank to auto-generate a secure random token per launch)
# ALEX_API_TOKEN=

# ------------------------------------------------------------------------------
# Frontend & Electron Configuration
# ------------------------------------------------------------------------------
# Loopback host for Vite dev server
ALEX_FRONTEND_HOST=127.0.0.1

# Loopback port for Vite dev server
ALEX_FRONTEND_PORT=5173

# Frontend URL loaded by the Electron desktop window in development
ALEX_FRONTEND_URL=http://127.0.0.1:5173/

# ------------------------------------------------------------------------------
# AI Provider Credentials & Local Model Settings
# (Prefer storing keys securely in OS Keyring via Settings UI rather than .env)
# ------------------------------------------------------------------------------
# Google Gemini API key fallback
GEMINI_API_KEY=

# Local Ollama endpoint (optional local model engine)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Local LM Studio endpoint (optional local model engine)
LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=local-model

# Third-party cloud providers (optional fallbacks; prefer OS Keyring)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# Speech Recognition & Voice Configuration (Phase 4)
# ------------------------------------------------------------------------------
# Speech recognition model (tiny, base, small, medium, large-v3, large-v3-turbo)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Speech synthesis engine: piper, system, cloud
TTS_ENGINE=piper
# Optional custom Piper voices storage directory
# PIPER_VOICE_DIR=

# Local Wake-Word detection ("Hey Alex")
WAKE_WORD_ENABLED=false
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
